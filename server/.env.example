# Copy to .env and fill in. Never commit the real .env.

# Required: shared secret the mobile app must present to control the engine.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_TOKEN=

# Required: path to the python/ directory of your own checkout of
# https://github.com/scripflipped/Krypt-Trader (clone/update it yourself;
# this repo does not vendor or modify that code).
KRYPT_TRADER_DIR=/path/to/Krypt-Trader/python

# Command used to launch the engine from KRYPT_TRADER_DIR.
KRYPT_SERVICE_CMD=python3 service.py

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8765
GATEWAY_LOG_LEVEL=INFO
